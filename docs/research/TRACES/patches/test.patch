diff -ruN -x build -x __pycache__ -x .git -x *.pyc -x *.bak wt-perf/repo2/ports/doomdmc/qhash.c wt-test/repo2/ports/doomdmc/qhash.c
--- wt-perf/repo2/ports/doomdmc/qhash.c	1969-12-31 19:00:00
+++ wt-test/repo2/ports/doomdmc/qhash.c	2026-11-03 19:42:26
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Verification build only (EXTRA_SRC=qhash.c, LDX=--wrap=G_Ticker, see tools/doomd_regress.sh):
+// the lockstep game-state hash of tests/lockstep/hash.c (identical to the host oracle's
+// stream, FNV-1a over players, sectors and every live mobj) after every game tic, printed as
+//   "TICHASH <gametic> <16 hex>\n"
+// The scratch the hash needs (2 B per handle slot) is borrowed from the frame area, which
+// is dead between G_Ticker and D_Display except for the strip cache, so frame hashes of a
+// hash build are only comparable with each other, not with the plain build.
+#include <stdint.h>
+#include "doomdef.h"
+#include "doomstat.h"
+#include "hash.h"
+#include "qplat.h"
+#include "things.h"
+
+/* hash.c is built with -Drndindex=ls_zero_rnd: rndindex (M_Random) is cosmetic and counts frame
+ * draws (wipes), which differ between a draw-per-tic oracle and this loop, so it is not hashed */
+const int ls_zero_rnd = 0; /* rodata: RAM is full, a bss word can push "plan D" over the edge */
+extern uint8_t __frame_start[], __ram_end[];
+void __real_G_Ticker(void);
+
+void __wrap_G_Ticker(void)
+{
+    int t = gametic;
+    __real_G_Ticker();
+    if (gamestate != GS_LEVEL) return;
+    uint32_t bytes = (uint32_t)(__ram_end - __frame_start);
+    uint64_t h = LS_HashScratch(__frame_start, bytes > 6144 ? 6144 : bytes);
+    for (int i = 0; i < EV_COUNT; i++)   /* object-store events (page pool exhausted...) change the game */
+        if (o_stats.events[i]) { q_puts("TICEVENTS "); q_putu((uint32_t)t); q_putc(' '); q_putu((uint32_t)i); q_putc('\n'); break; }
+    q_puts("TICHASH "); q_putu((uint32_t)t); q_putc(' ');
+    q_puthex((uint32_t)(h >> 32)); q_puthex((uint32_t)h); q_putc('\n');
+}
+
+#ifdef Q_TRACE_TIC
+void q_trace_put(const char *name, int idx, int v)
+{
+    if (gametic != Q_TRACE_TIC) return;
+    q_puts("T "); q_puts(name); q_putc(' '); q_putu((uint32_t)idx); q_putc(' '); q_putu((uint32_t)v); q_putc('\n');
+}
+#endif
diff -ruN -x build -x __pycache__ -x .git -x *.pyc -x *.bak wt-perf/repo2/ports/doomdmc/qsolid.c wt-test/repo2/ports/doomdmc/qsolid.c
--- wt-perf/repo2/ports/doomdmc/qsolid.c	2026-11-03 18:55:16
+++ wt-test/repo2/ports/doomdmc/qsolid.c	2026-11-03 19:44:12
@@ -1,25 +1,53 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 // /bin/doomd: R_SolidColumn (plan D floors and ceilings in one colour per light row) is a
-// function of (rows, plane height, colour, light) only. Neighbouring columns of a plane repeat
-// the call with identical arguments, so a repeat is a copy of the column just drawn. Linked with
-// --wrap=R_SolidColumn; the result is byte-identical (checked by frame dumps).
+// function of (rows, plane height, colour, light) only (its tables are const). Neighbouring
+// columns of a plane repeat the call with identical arguments, so a repeat is a copy of the
+// column just computed. Linked with --wrap=R_SolidColumn; the result is byte-identical
+// (checked by tools/doomd_regress.sh frame hashes).
+//
+// The copy comes from a PRIVATE buffer, never from the previous destination column: the strip
+// buffer column that was just drawn can be overdrawn (wall/sprite pixels, e.g. row 199 of the
+// DEMO1 frame at unique index 202) before the next plane column is requested, and copying that
+// column would replicate the overdraw across the whole run of columns.
 #include <stdint.h>
 #include <string.h>
 
 void __real_R_SolidColumn(uint8_t *dest, int y, int n, int32_t planeheight, int c, int startmap,
                           const uint8_t *cmaps, const uint8_t *fixedmap);
 
-static struct { const uint8_t *dest; int32_t ph; const uint8_t *cmaps, *fixed; uint16_t y, n; int16_t c, sm; } last;
+/* RAM is the limit here (the level arena takes whatever .bss leaves; 200 B for a column copy
+ * already makes "plan D: caches end 48 B into the arena" panic), so the last column is kept as
+ * runs of equal bytes (one run per light row, at most Q_SOLID_RUNS of them): 2 B per run. */
+#define Q_SOLID_MAX  200 /* R_VIEWH */
+#define Q_SOLID_RUNS 24
+static struct { const uint8_t *cmaps, *fixed; int32_t ph; uint8_t y, n, c, sm, valid, nr; } last; /* y < 200, n <= 200, c a colour, sm 0..31 */
+static uint8_t run_at[Q_SOLID_RUNS], run_val[Q_SOLID_RUNS]; /* row offset of the run, its byte */
 
 void __wrap_R_SolidColumn(uint8_t *dest, int y, int n, int32_t planeheight, int c, int startmap,
                           const uint8_t *cmaps, const uint8_t *fixedmap)
 {
-    if (last.dest && last.y == y && last.n == n && last.ph == planeheight && last.c == c &&
-        last.sm == startmap && last.cmaps == cmaps && last.fixed == fixedmap) {
-        memcpy(dest, last.dest, (uint32_t)n);
-    } else {
+    if (n <= 0 || n > Q_SOLID_MAX) {           /* not cacheable: behave exactly like the original */
+        last.valid = 0;
         __real_R_SolidColumn(dest, y, n, planeheight, c, startmap, cmaps, fixedmap);
+        return;
     }
-    last.dest = dest; last.y = (uint16_t)y; last.n = (uint16_t)n; last.ph = planeheight;
-    last.c = (int16_t)c; last.sm = (int16_t)startmap; last.cmaps = cmaps; last.fixed = fixedmap;
+    if (last.valid && last.y == y && last.n == n && last.ph == planeheight && last.c == c &&
+        last.sm == startmap && last.cmaps == cmaps && last.fixed == fixedmap) {
+        for (unsigned i = 0; i < last.nr; i++) {
+            unsigned end = i + 1 < last.nr ? run_at[i + 1] : (unsigned)n;
+            memset(dest + run_at[i], run_val[i], end - run_at[i]);
+        }
+        return;
+    }
+    __real_R_SolidColumn(dest, y, n, planeheight, c, startmap, cmaps, fixedmap);
+    unsigned nr = 0;
+    last.valid = 0;
+    for (int i = 0; i < n; i++) {
+        if (i && dest[i] == dest[i - 1]) continue;
+        if (nr == Q_SOLID_RUNS) return;        /* too many runs: leave the cache invalid */
+        run_at[nr] = (uint8_t)i; run_val[nr] = dest[i]; nr++;
+    }
+    last.nr = (uint8_t)nr; last.valid = 1; last.y = (uint8_t)y; last.n = (uint8_t)n;
+    last.ph = planeheight; last.c = (uint8_t)c; last.sm = (uint8_t)startmap;
+    last.cmaps = cmaps; last.fixed = fixedmap;
 }
