--- a/ports/doomdmc/mklayout.py	1969-12-31 19:00:00
+++ wt-ram/ports/doomdmc/mklayout.py	2026-11-03 19:07:39
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""RAM layout JSON for DMC100's converter (tools/conv/plan.py) from the built /bin/doomd ELF.
+usage: mklayout.py doomd.elf OUT.json [rc_line rc_sets]      (rc geometry must match build.sh RC_DEFS)
+The converter sizes each map's arena as ram_total - stack - fixed_core - frame region - caches, and
+the engine places the arena at __ram_end - arena_bytes, so stack = the doomd stack reserve and
+fixed_core = __frame_start (kernel core + engine .data/.bss, everything below the frame region).
+Every plan has K = 1 flat slot (the flats that did not fit the data ROM are loaded into it) and is textured; B, C and D are the
+same w = 8 plan (frame regions below 8368 B would overlap the front-end compose buffers)."""
+import json, subprocess, sys
+elf, out = sys.argv[1:3]
+line, sets = (int(sys.argv[3]), int(sys.argv[4])) if len(sys.argv) > 4 else (16, 16)
+w8only = len(sys.argv) > 5 and sys.argv[5] == 'w8'   # experiment: no w = 16 plan
+import os
+K = int(os.environ.get("QFLAT_SLOTS", 1))   # RAM flat slots for the flats that are not in data ROM
+sy = {}
+for l in subprocess.check_output(['readelf', '-sW', elf], text=True).splitlines():
+    f = l.split()
+    if len(f) >= 8 and f[0].rstrip(':').isdigit(): sy[f[-1]] = int(f[1], 16)
+stack = 0x8000 - sy['__stack_limit']
+lay = json.load(open('/dev/stdin')) if False else None
+base = {
+ "comment": "QwenOS /bin/doomd RAM layout, generated by ports/doomdmc/mklayout.py",
+ "ram_total": 32768, "stack": stack, "fixed_core": sy['__frame_start'],
+ "plans": {"A": {"w": 8, "k": K, "textured": True, "frame_region": 9648} if w8only else {"w": 16, "k": K, "textured": True, "frame_region": 15208},
+           "B": {"w": 8, "k": K, "textured": True, "frame_region": 9648},
+           "C": {"w": 8, "k": K, "textured": True, "frame_region": 9648},
+           "D": {"w": 8, "k": K, "textured": True, "frame_region": 9648}},
+ "map_cache_lines": 4 * sets, "map_cache_bytes": 4 * sets * (line + 2) + sets, "flat_slot_bytes": 1028,
+ "page_bytes": 60, "reserve_pages": 8, "transients": 24, "awake_min": 24, "awake_percent": 30,
+ "level_fixed": {"sector_bytes": 1, "mutable_bytes": 10, "line_bits": 2, "special_bits": 1,
+  "switch_bytes": 16, "button_bytes": 128, "tier_bits": 2, "sleep_bytes": 1, "monster_bits": 1,
+  "zclip_bytes": 4, "blockmap_hash_bytes": 256, "sector_hash_bytes": 128, "light_bytes": 8,
+  "mover_bytes": 20, "mover_max": 32, "platlist_bytes": 60, "drop_bytes": 16}}
+json.dump(base, open(out, 'w'), indent=1)
+print('layout: stack %d fixed_core %d caches %d -> arena(A) %d arena(B) %d' % (
+    stack, sy['__frame_start'], base['map_cache_bytes'],
+    32768 - stack - sy['__frame_start'] - 15208 - base['map_cache_bytes'] - K * 1028,
+    32768 - stack - sy['__frame_start'] - 9648 - base['map_cache_bytes'] - K * 1028))
