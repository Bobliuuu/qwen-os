+static void nor_store(uint32_t phys, const uint8_t *src, uint32_t n)
+{
+    while (n) {
+        uint32_t c = n > QOS_DISK_WINDOW ? QOS_DISK_WINDOW : n;
+        if (qapi->syscall(QOS_SYS_DISK_WRITE, q_nor_base + phys, (uintptr_t)src, c))
