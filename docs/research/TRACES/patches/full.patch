+int __real_I_StartSound(sfxinfo_t *sfxinfo, int channel, int vol, int sep);
+int __wrap_I_StartSound(sfxinfo_t *sfxinfo, int channel, int vol, int sep)
+{
+    int id = (int)(sfxinfo - S_sfx);
+    if (id > 0 && id < 128) { q_putc(3); q_putc(0x80 | id); }
+    return __real_I_StartSound(sfxinfo, channel, vol, sep);
+}
 void snd_volume(int vol) { (void)vol; }
 void snd_play(const uint8_t *tones, uint32_t n) { (void)tones; (void)n; }
 void snd_stop(void) {}
