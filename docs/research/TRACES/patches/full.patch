+int nor_program(uint32_t phys, const void *src, uint32_t n)
+{
+    const uint8_t *s = src;
+    uint8_t old[256], buf[256];
+    while (n) {
+        uint32_t c = n > 256 ? 256 : n;
+        nor_hw(phys, old, c);
+        for (uint32_t i = 0; i < c; i++) buf[i] = old[i] & s[i];
+        nor_store(phys, buf, c);
+        phys += c; s += c; n -= c;
+    }
+    return 0;
