+    static const uint8_t ff[256] = {[0 ... 255] = 0xFF};
+    if (!n) return -1;
+    phys &= ~(n - 1);
+    for (uint32_t o = 0; o < n; o += 256) nor_store(phys + o, ff, 256);
+    return 0;
