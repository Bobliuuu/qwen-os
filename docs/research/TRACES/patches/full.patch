+    uint8_t b[8];
+    if (qapi->syscall(QOS_SYS_DISK_REQUEST, k * EP_STRIDE + 0x100000u + 3, (uintptr_t)b, 8)) return 0;
+    uint32_t r = 0;
+    for (unsigned j = 0; j < 64 && !r; j++) r = qapi->syscall(QOS_SYS_DISK_POLL, 0, 0, 0);
+    if (r != 8) { qapi->syscall(QOS_SYS_DISK_CANCEL, 0, 0, 0); return 0; }
