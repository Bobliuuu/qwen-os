+// "letterbox" view (rows outside are never drawn nor sent).
+#ifdef Q_VTOP
+#define R_CLIPTOP (Q_VTOP - 1)
+#define R_CLIPBOT (Q_VBOT)
+#else
+#define R_CLIPTOP (-1)
+#define R_CLIPBOT (viewheight)
+#endif
