+void I_Error(char *error, ...)
+{
+    static int nested;
+    char msg[512];
+    va_list ap;
+    va_start(ap, error);
+    vsnprintf(msg, sizeof(msg), error, ap);
+    va_end(ap);
+    if (nested++)
+        exit(1);
+    finish();
+    if (!strncmp(msg, "timed ", 6)) {
+        printf("%s\n", msg);
+        exit(0);
+    }
+    fprintf(stderr, "%s\n", msg);
+    exit(1);
+}
