+#define LS_STORE 1
+#include "things.h"
+#define LS_TYPE(t) dmc_mobj_vanilla[t]
+#define LS_STATE(s) dmc_state_vanilla[s]
+#define LS_PSPSTATE(st) dmc_state_vanilla[(st) - dmc_states]
+#else
+#define LS_PSPSTATE(st) ((st) - states)
+#endif
