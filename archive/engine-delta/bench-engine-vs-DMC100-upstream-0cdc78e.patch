+//
+// P_MakeDivline
+//
+void
+P_MakeDivline
+( line_t*	li,
+  divline_t*	dl )
+{
+    dl->x = li->v1x;
+    dl->y = li->v1y;
+    dl->dx = li->dx;
+    dl->dy = li->dy;
+}
