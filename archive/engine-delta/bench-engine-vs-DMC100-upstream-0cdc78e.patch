+//
+// KillMobj
+//
+void
+P_KillMobj
+( mobj_t*	source,
+  mobj_t*	target )
+{
+    mobjtype_t	item;
+    player_t*	tp = MO_PLAYER(target);
+    player_t*	sp = source ? MO_PLAYER(source) : NULL;
+    const dmc_actorinfo_t* info = MINFO(target);
+	
+    target->flags &= ~(MF_SHOOTABLE|MF_FLOAT|MF_SKULLFLY);
+
+#ifdef DMC_HAVE_MT_SKULL
+    if (target->type != MT_SKULL)
+#endif
+	target->flags &= ~MF_NOGRAVITY;
+
+    // the height becomes a quarter with MF_CORPSE (P_Height)
+    target->flags |= MF_CORPSE|MF_DROPOFF;
+
+    if (sp)
+    {
+	// count for intermission
+	if (target->flags & MF_COUNTKILL)
+	    sp->killcount++;	
+
+	if (tp)
+	    sp->frags[0]++;
+    }
+    else if (!netgame && (target->flags & MF_COUNTKILL) )
+    {
+	// count all monster deaths,
+	// even those caused by other monsters
+	players[0].killcount++;
+    }
+    
+    if (tp)
+    {
+	// count environment kills against you
+	if (!source)	
+	    tp->frags[0]++;
+			
+	target->flags &= ~MF_SOLID;
+	tp->playerstate = PST_DEAD;
+	P_DropWeapon (tp);
+
+	if (tp == &players[consoleplayer]
+	    && automapactive)
+	{
+	    // don't die in auto map,
+	    // switch view prior to dying
+	    AM_Stop ();
+	}
+	
+    }
+
+    if (target->health < -MI_SPAWNHEALTH(target->type) 
+	&& info->xdeathstate)
+    {
+	P_SetMobjState (target, info->xdeathstate);
+    }
+    else
+	P_SetMobjState (target, info->deathstate);
+    target->tics -= P_Random()&3;
+
+    if (target->tics < 1)
+	target->tics = 1;
+		
+    //	I_StartSound (&actor->r, actor->info->deathsound);
+
+    // Drop stuff.
+    // This determines the kind of object spawned
+    // during the death frame of a thing.
+    switch (target->type)
+    {
+      case MT_POSSESSED:
+	item = MT_CLIP;
+	break;
+	
+      case MT_SHOTGUY:
+	item = MT_SHOTGUN;
+	break;
+	
+      default:
+	return;
+    }
+
+    // special versions of items, at rest a 16 B record
+    O_SpawnDrop (target->x, target->y, item);
+}
