+		--script port/ovl/ovl.ld -o $$@ $(call FW_OVL_OBJS,$(1),$(2))
+$(FW_B)/$(1)/$(2).elf: $(FW_B)/$(1)/$(2).ld $(call FW_OVL_OBJS,$(1),$(2)) $(FW_B)/$(1)/main.elf
