+//
+// FLOORS
+//
+
+//
+// Move a plane (floor or ceiling) and check for crushing
+//
+result_e
+T_MovePlane
+( secidx_t	sector,
+  fixed_t	speed,
+  fixed_t	dest,
+  boolean	crush,
+  int		floorOrCeiling,
+  int		direction )
+{
+    boolean	flag;
+    fixed_t	lastpos;
+    secovl_t*	sec = P_SecOvl(sector);
+	
+    switch(floorOrCeiling)
+    {
+      case 0:
+	// FLOOR
+	switch(direction)
+	{
+	  case -1:
+	    // DOWN
+	    if (FX8(sec->floor8) - speed < dest)
+	    {
+		lastpos = FX8(sec->floor8);
+		sec->floor8 = TO8(dest);
+		flag = P_ChangeSector(sector,crush);
+		if (flag == true)
+		{
+		    sec->floor8 = TO8(lastpos);
+		    P_ChangeSector(sector,crush);
+		    //return crushed;
+		}
+		return pastdest;
+	    }
+	    else
+	    {
+		lastpos = FX8(sec->floor8);
+		sec->floor8 -= TO8(speed);
+		flag = P_ChangeSector(sector,crush);
+		if (flag == true)
+		{
+		    sec->floor8 = TO8(lastpos);
+		    P_ChangeSector(sector,crush);
+		    return crushed;
+		}
+	    }
+	    break;
+						
+	  case 1:
+	    // UP
+	    if (FX8(sec->floor8) + speed > dest)
+	    {
+		lastpos = FX8(sec->floor8);
+		sec->floor8 = TO8(dest);
+		flag = P_ChangeSector(sector,crush);
+		if (flag == true)
+		{
+		    sec->floor8 = TO8(lastpos);
+		    P_ChangeSector(sector,crush);
+		    //return crushed;
+		}
+		return pastdest;
+	    }
+	    else
+	    {
+		// COULD GET CRUSHED
+		lastpos = FX8(sec->floor8);
+		sec->floor8 += TO8(speed);
+		flag = P_ChangeSector(sector,crush);
+		if (flag == true)
+		{
+		    if (crush == true)
+			return crushed;
+		    sec->floor8 = TO8(lastpos);
+		    P_ChangeSector(sector,crush);
+		    return crushed;
+		}
+	    }
+	    break;
+	}
+	break;
+									
+      case 1:
+	// CEILING
+	switch(direction)
+	{
+	  case -1:
+	    // DOWN
+	    if (FX8(sec->ceil8) - speed < dest)
+	    {
+		lastpos = FX8(sec->ceil8);
+		sec->ceil8 = TO8(dest);
+		flag = P_ChangeSector(sector,crush);
+
+		if (flag == true)
+		{
+		    sec->ceil8 = TO8(lastpos);
+		    P_ChangeSector(sector,crush);
+		    //return crushed;
+		}
+		return pastdest;
+	    }
+	    else
+	    {
+		// COULD GET CRUSHED
+		lastpos = FX8(sec->ceil8);
+		sec->ceil8 -= TO8(speed);
+		flag = P_ChangeSector(sector,crush);
+
+		if (flag == true)
+		{
+		    if (crush == true)
+			return crushed;
+		    sec->ceil8 = TO8(lastpos);
+		    P_ChangeSector(sector,crush);
+		    return crushed;
+		}
+	    }
+	    break;
+						
+	  case 1:
+	    // UP
+	    if (FX8(sec->ceil8) + speed > dest)
+	    {
+		lastpos = FX8(sec->ceil8);
+		sec->ceil8 = TO8(dest);
+		flag = P_ChangeSector(sector,crush);
+		if (flag == true)
+		{
+		    sec->ceil8 = TO8(lastpos);
+		    P_ChangeSector(sector,crush);
+		    //return crushed;
+		}
+		return pastdest;
+	    }
+	    else
+	    {
+		lastpos = FX8(sec->ceil8);
+		sec->ceil8 += TO8(speed);
+		flag = P_ChangeSector(sector,crush);
+// UNUSED
+#if 0
+		if (flag == true)
+		{
+		    sec->ceil8 = TO8(lastpos);
+		    P_ChangeSector(sector,crush);
+		    return crushed;
+		}
+#endif
+	    }
+	    break;
+	}
+	break;
+		
+    }
+    return ok;
+}
