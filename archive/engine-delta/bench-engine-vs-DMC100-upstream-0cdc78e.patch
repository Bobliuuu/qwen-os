+//
+// P_TouchSpecialThing
+//
+void
+P_TouchSpecialThing
+( mobj_t*	special,
+  mobj_t*	toucher )
+{
+    player_t*	player;
+    int		i;
+    fixed_t	delta;
+    int		sound;
+    int		msg = -1;
+		
+    delta = special->z - toucher->z;
+
+    if (delta > P_Height(toucher)
+	|| delta < -8*FRACUNIT)
+    {
+	// out of reach
+	return;
+    }
+    
+	
+    sound = sfx_itemup;	
+    player = MO_PLAYER(toucher);
+
+    // Dead thing touching.
+    // Can happen with a sliding player corpse.
+    if (toucher->health <= 0)
+	return;
+
+    // Identify by sprite. The megasphere, the skull keys,
+    // invulnerability, the light amplification visor and the BFG
+    // are not in E1.
+    switch (dmc_states[special->statenum].sprite)
+    {
+	// armor
+      case SPR_ARM1:
+	if (!P_GiveArmor (player, deh_green_armor_class))
+	    return;
+	msg = DMC_STR_GOTARMOR;
+	break;
+		
+      case SPR_ARM2:
+	if (!P_GiveArmor (player, deh_blue_armor_class))
+	    return;
+	msg = DMC_STR_GOTMEGA;
+	break;
+	
+	// bonus items
+      case SPR_BON1:
+	player->health++;		// can go over 100%
+	if (player->health > deh_max_health)
+	    player->health = deh_max_health;
+	player->mo->health = player->health;
+	msg = DMC_STR_GOTHTHBONUS;
+	break;
+	
+      case SPR_BON2:
+	player->armorpoints++;		// can go over 100%
+	if (player->armorpoints > deh_max_armor)
+	    player->armorpoints = deh_max_armor;
+        // deh_green_armor_class only applies to the green armor shirt;
+        // for the armor helmets, armortype 1 is always used.
+	if (!player->armortype)
+	    player->armortype = 1;
+	msg = DMC_STR_GOTARMBONUS;
+	break;
+	
+      case SPR_SOUL:
+	player->health += deh_soulsphere_health;
+	if (player->health > deh_max_soulsphere)
+	    player->health = deh_max_soulsphere;
+	player->mo->health = player->health;
+	msg = DMC_STR_GOTSUPER;
+	sound = sfx_getpow;
+	break;
+	
+	// cards
+	// leave cards for everyone
+      case SPR_BKEY:
+	if (!player->cards[it_bluecard])
+	    msg = DMC_STR_GOTBLUECARD;
+	P_GiveCard (player, it_bluecard);
+	if (!netgame)
+	    break;
+	return;
+	
+      case SPR_YKEY:
+	if (!player->cards[it_yellowcard])
+	    msg = DMC_STR_GOTYELWCARD;
+	P_GiveCard (player, it_yellowcard);
+	if (!netgame)
+	    break;
+	return;
+	
+      case SPR_RKEY:
+	if (!player->cards[it_redcard])
+	    msg = DMC_STR_GOTREDCARD;
+	P_GiveCard (player, it_redcard);
+	if (!netgame)
+	    break;
+	return;
+	
+	// medikits, heals
+      case SPR_STIM:
+	if (!P_GiveBody (player, 10))
+	    return;
+	msg = DMC_STR_GOTSTIM;
+	break;
+	
+      case SPR_MEDI:
+	if (!P_GiveBody (player, 25))
+	    return;
+
+	if (player->health < 25)
+	    msg = DMC_STR_GOTMEDINEED;
+	else
+	    msg = DMC_STR_GOTMEDIKIT;
+	break;
+
+	
+	// power ups
+#ifdef DMC_HAVE_SPR_PSTR
+      case SPR_PSTR:
+	if (!P_GivePower (player, pw_strength))
+	    return;
+	msg = DMC_STR_GOTBERSERK;
+	if (player->readyweapon != wp_fist)
+	    player->pendingweapon = wp_fist;
+	sound = sfx_getpow;
+	break;
+#endif
+	
+      case SPR_PINS:
+	if (!P_GivePower (player, pw_invisibility))
+	    return;
+	msg = DMC_STR_GOTINVIS;
+	sound = sfx_getpow;
+	break;
+	
+      case SPR_SUIT:
+	if (!P_GivePower (player, pw_ironfeet))
+	    return;
+	msg = DMC_STR_GOTSUIT;
+	sound = sfx_getpow;
+	break;
+	
+      case SPR_PMAP:
+	if (!P_GivePower (player, pw_allmap))
+	    return;
+	msg = DMC_STR_GOTMAP;
+	sound = sfx_getpow;
+	break;
+	
+#ifdef DMC_HAVE_SPR_PVIS
+      case SPR_PVIS:
+	if (!P_GivePower (player, pw_infrared))
+	    return;
+	msg = DMC_STR_GOTVISOR;
+	sound = sfx_getpow;
+	break;
+#endif
+	
+	// ammo
+      case SPR_CLIP:
+	if (special->flags & MF_DROPPED)
+	{
+	    if (!P_GiveAmmo (player,am_clip,0))
+		return;
+	}
+	else
+	{
+	    if (!P_GiveAmmo (player,am_clip,1))
+		return;
+	}
+	msg = DMC_STR_GOTCLIP;
+	break;
+	
+      case SPR_AMMO:
+	if (!P_GiveAmmo (player, am_clip,5))
+	    return;
+	msg = DMC_STR_GOTCLIPBOX;
+	break;
+	
+      case SPR_ROCK:
+	if (!P_GiveAmmo (player, am_misl,1))
+	    return;
+	msg = DMC_STR_GOTROCKET;
+	break;
+	
+      case SPR_BROK:
+	if (!P_GiveAmmo (player, am_misl,5))
+	    return;
+	msg = DMC_STR_GOTROCKBOX;
+	break;
+	
+#ifdef DMC_HAVE_SPR_CELL
+      case SPR_CELL:
+	if (!P_GiveAmmo (player, am_cell,1))
+	    return;
+	msg = DMC_STR_GOTCELL;
+	break;
+#endif
+	
+#ifdef DMC_HAVE_SPR_CELP
+      case SPR_CELP:
+	if (!P_GiveAmmo (player, am_cell,5))
+	    return;
+	msg = DMC_STR_GOTCELLBOX;
+	break;
+#endif
+	
+      case SPR_SHEL:
+	if (!P_GiveAmmo (player, am_shell,1))
+	    return;
+	msg = DMC_STR_GOTSHELLS;
+	break;
+	
+      case SPR_SBOX:
+	if (!P_GiveAmmo (player, am_shell,5))
+	    return;
+	msg = DMC_STR_GOTSHELLBOX;
+	break;
+	
+      case SPR_BPAK:
+	if (!player->backpack)
+	{
+	    for (i=0 ; i<NUMAMMO ; i++)
+		player->maxammo[i] *= 2;
+	    player->backpack = true;
+	}
+	for (i=0 ; i<NUMAMMO ; i++)
+	    P_GiveAmmo (player, i, 1);
+	msg = DMC_STR_GOTBACKPACK;
+	break;
+	
+	// weapons
+      case SPR_MGUN:
+	if (!P_GiveWeapon (player, wp_chaingun, (special->flags&MF_DROPPED) != 0) )
+	    return;
+	msg = DMC_STR_GOTCHAINGUN;
+	sound = sfx_wpnup;	
+	break;
+	
+      case SPR_CSAW:
+	if (!P_GiveWeapon (player, wp_chainsaw, false) )
+	    return;
+	msg = DMC_STR_GOTCHAINSAW;
+	sound = sfx_wpnup;	
+	break;
+	
+      case SPR_LAUN:
+	if (!P_GiveWeapon (player, wp_missile, false) )
+	    return;
+	msg = DMC_STR_GOTLAUNCHER;
+	sound = sfx_wpnup;	
+	break;
+	
+#ifdef DMC_HAVE_SPR_PLAS
+      case SPR_PLAS:
+	if (!P_GiveWeapon (player, wp_plasma, false) )
+	    return;
+	msg = DMC_STR_GOTPLASMA;
+	sound = sfx_wpnup;	
+	break;
+#endif
+	
+      case SPR_SHOT:
+	if (!P_GiveWeapon (player, wp_shotgun, (special->flags&MF_DROPPED) != 0 ) )
+	    return;
+	msg = DMC_STR_GOTSHOTGUN;
+	sound = sfx_wpnup;	
+	break;
+		
+      default:
+	I_Error ("P_SpecialThing: Unknown gettable thing");
+    }
+	
+    if (msg >= 0)
+	player->message = P_String(msg);
+    if (special->flags & MF_COUNTITEM)
+	player->itemcount++;
+    P_RemoveMobj (special);
+    player->bonuscount += BONUSADD;
+    if (player == &players[consoleplayer])
+	S_StartSound (NULL, sound);
+}
