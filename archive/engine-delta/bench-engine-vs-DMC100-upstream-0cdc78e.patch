+    v += _arr("uint16_t", "dmc_vatx_prefix_high", v0["vatx"]["prefix"], 16)
+    v += _arr("uint32_t", "dmc_vatx_words_low", v1["vatx"]["words"], 8, "0x%08xu")
+    v += _arr("uint16_t", "dmc_vatx_prefix_low", v1["vatx"]["prefix"], 16)
