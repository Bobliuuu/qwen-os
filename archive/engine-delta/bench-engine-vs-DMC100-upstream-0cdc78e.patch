+
+//
+// BUILD A STAIRCASE!
+// count: count the sectors that would start moving, without moving
+// them (the all-or-nothing mover reservation).
+//
+static int
+P_Stairs
+( lineidx_t	line,
+  stair_e	type,
+  boolean	count )
+{
+    int			secnum;
+    int			height;
+    int			i;
+    int			newsecnum;
+    int			texture;
+    int			ok;
+    int			rtn;
+    int			first;
+    int			nlines;
+    line_t		l;
+    
+    secidx_t		sec;
+    secidx_t		tsec;
+
+    floormove_t*	floor;
+    
+    fixed_t		stairsize = 0;
+    fixed_t		speed = 0;
+
+    secnum = -1;
+    rtn = 0;
+    while ((secnum = P_FindSectorFromLineTag(line,secnum)) >= 0)
+    {
+	sec = secnum;
+		
+	// ALREADY MOVING?  IF SO, KEEP GOING...
+	if (P_SecMover(sec) != NOMOVER || (secstat[sec] & SS_QUEUED))
+	    continue;
+	
+	switch(type)
+	{
+	  case build8:
+	    speed = FLOORSPEED/4;
+	    stairsize = 8*FRACUNIT;
+	    break;
+	  case turbo16:
+	    speed = FLOORSPEED*4;
+	    stairsize = 16*FRACUNIT;
+	    break;
+	}
+	height = P_FloorHeight(sec) + stairsize;
+
+	// new floor thinker
+	if (count)
+	{
+	    rtn++;
+	    secstat[sec] |= SS_QUEUED;
+	}
+	else
+	{
+	    rtn = 1;
+	    floor = &P_NewMover (MV_FLOOR, sec)->floor;
+	    floor->direction = 1;
+	    floor->speed8 = TO8(speed);
+	    floor->dest8 = TO8(height);
+	}
+		
+	texture = P_FloorPic(sec);
+	
+	// Find next sector to raise
+	// 1.	Find 2-sided line with same sector side[0]
+	// 2.	Other side is the next sector to raise
+	do
+	{
+	    ok = 0;
+	    nlines = P_SecLines(sec, &first);
+	    for (i = 0;i < nlines;i++)
+	    {
+		P_GetLine(P_SecLine(first + i), &l);
+		if ( !(l.flags & ML_TWOSIDED) )
+		    continue;
+					
+		tsec = l.frontsector;
+		newsecnum = tsec;
+		
+		if (secnum != newsecnum)
+		    continue;
+
+		tsec = l.backsector;
+		newsecnum = tsec;
+
+		if (P_FloorPic(tsec) != texture)
+		    continue;
+					
+		height += stairsize;
+
+		if (P_SecMover(tsec) != NOMOVER || (secstat[tsec] & SS_QUEUED))
+		    continue;
+					
+		sec = tsec;
+		secnum = newsecnum;
+		if (count)
+		{
+		    rtn++;
+		    secstat[sec] |= SS_QUEUED;
+		}
+		else
+		{
+		    floor = &P_NewMover (MV_FLOOR, sec)->floor;
+		    floor->direction = 1;
+		    floor->speed8 = TO8(speed);
+		    floor->dest8 = TO8(height);
+		}
+		ok = 1;
+		break;
+	    }
+	} while(ok);
+    }
+    if (count)
+	for (i = 0; i < numsectors; i++)
+	    secstat[i] &= ~SS_QUEUED;
+    return rtn;
+}
+
+int
+EV_BuildStairs
+( lineidx_t	line,
+  stair_e	type )
+{
+    return P_Stairs(line, type, false);
+}
+
+int P_StairDemand (lineidx_t line, stair_e type)
+{
+    return P_Stairs(line, type, true);
+}
