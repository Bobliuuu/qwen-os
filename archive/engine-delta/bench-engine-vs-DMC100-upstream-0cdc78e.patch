+static char *deh_prompt(void)
+{
+    static char *nightmare, *dosy, *quit[NUM_QUITMESSAGES];
+    if (!messageToPrint)
+        return NULL;
+    if (messageRoutine == M_VerifyNightmare) {
+        if (!nightmare)
+            nightmare = deh_string("NIGHTMARE");
