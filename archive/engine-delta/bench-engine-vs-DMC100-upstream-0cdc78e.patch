+//
+// VERTICAL DOORS
+//
+
+//
+// T_VerticalDoor
+//
+void T_VerticalDoor (vldoor_t* door)
+{
+    result_e	res;
+    void*	org = P_SecSoundOrg(door->sector);
+	
+    switch(door->direction)
+    {
+      case 0:
+	// WAITING
+	if (!--door->topcountdown)
+	{
+	    switch(door->type)
+	    {
+	      case vld_blazeRaise:
+		door->direction = -1; // time to go back down
+		S_StartSound(org, sfx_bdcls);
+		break;
+		
+	      case vld_normal:
+		door->direction = -1; // time to go back down
+		S_StartSound(org, sfx_dorcls);
+		break;
+		
+	      case vld_close30ThenOpen:
+		door->direction = 1;
+		S_StartSound(org, sfx_doropn);
+		break;
+		
+	      default:
+		break;
+	    }
+	}
+	break;
+	
+      case 2:
+	//  INITIAL WAIT
+	if (!--door->topcountdown)
+	{
+	    switch(door->type)
+	    {
+	      case vld_raiseIn5Mins:
+		door->direction = 1;
+		door->type = vld_normal;
+		S_StartSound(org, sfx_doropn);
+		break;
+		
+	      default:
+		break;
+	    }
+	}
+	break;
+	
+      case -1:
+	// DOWN
+	res = T_MovePlane(door->sector,
+			  FX8(door->speed8),
+			  P_FloorHeight(door->sector),
+			  false,1,door->direction);
+	if (res == pastdest)
+	{
+	    switch(door->type)
+	    {
+	      case vld_blazeRaise:
+	      case vld_blazeClose:
+		P_SecOvl(door->sector)->mover = NOMOVER;
+		P_RemoveMover (door);  // unlink and free
+		S_StartSound(org, sfx_bdcls);
+		break;
+		
+	      case vld_normal:
+	      case vld_close:
+		P_SecOvl(door->sector)->mover = NOMOVER;
+		P_RemoveMover (door);  // unlink and free
+		break;
+		
+	      case vld_close30ThenOpen:
+		door->direction = 0;
+		door->topcountdown = TICRATE*30;
+		break;
+		
+	      default:
+		break;
+	    }
+	}
+	else if (res == crushed)
+	{
+	    switch(door->type)
+	    {
+	      case vld_blazeClose:
+	      case vld_close:		// DO NOT GO BACK UP!
+		break;
+		
+	      default:
+		door->direction = 1;
+		S_StartSound(org, sfx_doropn);
+		break;
+	    }
+	}
+	break;
+	
+      case 1:
+	// UP
+	res = T_MovePlane(door->sector,
+			  FX8(door->speed8),
+			  FX8(door->top8),
+			  false,1,door->direction);
+	
+	if (res == pastdest)
+	{
+	    switch(door->type)
+	    {
+	      case vld_blazeRaise:
+	      case vld_normal:
+		door->direction = 0; // wait at top
+		door->topcountdown = door->topwait;
+		break;
+		
+	      case vld_close30ThenOpen:
+	      case vld_blazeOpen:
+	      case vld_open:
+		P_SecOvl(door->sector)->mover = NOMOVER;
+		P_RemoveMover (door);  // unlink and free
+		break;
+		
+	      default:
+		break;
+	    }
+	}
+	break;
+    }
+}
