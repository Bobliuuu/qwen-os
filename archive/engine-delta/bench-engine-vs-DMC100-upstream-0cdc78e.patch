+static void
+M_StartMessage
+( int		msg,
+  boolean	input )
+{
+    if (!menuactive)
+	M_PanelReset();
+    messageLastMenuActive = menuactive;
+    messageToPrint = 1;
+    fe.msg = msg;
+    messageNeedsInput = input;
+    menuactive = true;
+    return;
+}
