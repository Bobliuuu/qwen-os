+    ev_keydown,
+    ev_keyup,
+    ev_mouse,
+    ev_joystick,
+    ev_quit
+} evtype_t;
+
+// Event structure.
+typedef struct
+{
+    evtype_t type;
+
+    // Event-related data that depends on the type of event:
+    //
+    // ev_keydown/ev_keyup:
+    //    data1: Key code (from doomkeys.h) of the key that was
