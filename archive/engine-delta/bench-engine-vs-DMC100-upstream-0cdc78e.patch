+
+//
+// EV_DoLockedDoor
+// Move a locked door up/down
+//
+
+int
+EV_DoLockedDoor
+( lineidx_t	line,
+  vldoor_e	type,
+  mobj_t*	thing )
+{
+    player_t*	p;
+    int		ok = 1;
+	
+    p = MO_PLAYER(thing);
+	
+    if (!p)
+	return 0;
+		
+    switch(P_LineSpecial(line))
+    {
+      case 99:	// Blue Lock
+      case 133:
+	ok = P_DoorKey(p, it_bluecard, DMC_STR_PD_BLUEO);
+	break;
+	
+      case 134: // Red Lock
+      case 135:
+	ok = P_DoorKey(p, it_redcard, DMC_STR_PD_REDO);
+	break;
+	
+      case 136:	// Yellow Lock
+      case 137:
+	ok = P_DoorKey(p, it_yellowcard, DMC_STR_PD_YELLOWO);
+	break;	
+    }
+    if (!ok)
+	return 0;
+
+    // all movers of the activation or none, after the key test
+    if (!P_MoverReserveTagged(line))
+	return 0;
+    return EV_DoDoor(line,type);
+}
+
+
+int
+EV_DoDoor
+( lineidx_t	line,
+  vldoor_e	type )
+{
+    int		secnum,rtn;
+    secidx_t	sec;
+    vldoor_t*	door;
+    fixed_t	top;
+    void*	org;
+	
+    secnum = -1;
+    rtn = 0;
+    
+    while ((secnum = P_FindSectorFromLineTag(line,secnum)) >= 0)
+    {
+	sec = secnum;
+	if (P_SecMover(sec) != NOMOVER)
+	    continue;
+		
+	
+	// new door thinker
+	rtn = 1;
+	door = &P_NewMover (MV_DOOR, sec)->door;
+	door->type = type;
+	door->topwait = VDOORWAIT;
+	door->speed8 = TO8(VDOORSPEED);
+	org = P_SecSoundOrg(sec);
+		
+	switch(type)
+	{
+	  case vld_blazeClose:
+	    top = P_FindLowestCeilingSurrounding(sec);
+	    top -= 4*FRACUNIT;
+	    door->top8 = TO8(top);
+	    door->direction = -1;
+	    door->speed8 = TO8(VDOORSPEED * 4);
+	    S_StartSound(org, sfx_bdcls);
+	    break;
+	    
+	  case vld_close:
+	    top = P_FindLowestCeilingSurrounding(sec);
+	    top -= 4*FRACUNIT;
+	    door->top8 = TO8(top);
+	    door->direction = -1;
+	    S_StartSound(org, sfx_dorcls);
+	    break;
+	    
+	  case vld_close30ThenOpen:
+	    door->top8 = TO8(P_CeilingHeight(sec));
+	    door->direction = -1;
+	    S_StartSound(org, sfx_dorcls);
+	    break;
+	    
+	  case vld_blazeRaise:
+	  case vld_blazeOpen:
+	    door->direction = 1;
+	    top = P_FindLowestCeilingSurrounding(sec);
+	    top -= 4*FRACUNIT;
+	    door->top8 = TO8(top);
+	    door->speed8 = TO8(VDOORSPEED * 4);
+	    if (top != P_CeilingHeight(sec))
+		S_StartSound(org, sfx_bdopn);
+	    break;
+	    
+	  case vld_normal:
+	  case vld_open:
+	    door->direction = 1;
+	    top = P_FindLowestCeilingSurrounding(sec);
+	    top -= 4*FRACUNIT;
+	    door->top8 = TO8(top);
+	    if (top != P_CeilingHeight(sec))
+		S_StartSound(org, sfx_doropn);
+	    break;
+	    
+	  default:
+	    break;
+	}
+		
+    }
+    return rtn;
+}
