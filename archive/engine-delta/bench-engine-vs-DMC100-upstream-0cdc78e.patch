+int dmc_demo_open(const char *name, uint32_t *size)
+{
+    if (demo_f)
+        fclose(demo_f);
+    demo_f = fopen(name, "rb");
+    if (!demo_f || fseek(demo_f, 0, SEEK_END))
+        return -1;
+    demo_size = (uint32_t)ftell(demo_f);
+    *size = demo_size;
+    return 0;
+}
