+// List of names for levels in commercial IWADs
+// (doom2.wad, plutonia.wad, tnt.wad).  These are stored in a
+// single large array; WADs like pl2.wad have a MAP33, and rely on
+// the layout in the Vanilla executable, where it is possible to
+// overflow the end of one array into the next.
+
+
+// The heads-up font is in the UIDIR of the image (HU_FONT).
+void HU_Init(void)
+{
+}
+
+void HU_Stop(void)
+{
+    headsupactive = false;
+}
+
+void HU_Start(void)
+{
+
+#ifndef DMC_FW
+    char*	s;
+#endif
+
+    if (headsupactive)
+	HU_Stop();
+
+    plr = &players[consoleplayer];
+    message_on = false;
+    message_dontfuckwithme = false;
+    message_nottobefuckedwith = false;
+
+    // create the message widget
+    HUlib_initSText(&w_message,
+		    HU_MSGX, HU_MSGY, HU_MSGHEIGHT,
+		    DMC_UI_STCFN033,
+		    HU_FONTSTART, &message_on);
+
+#ifndef DMC_FW
+    // create the map title widget
+    HUlib_initTextLine(&w_title,
+		       HU_TITLEX, HU_TITLEY,
+		       DMC_UI_STCFN033,
+		       HU_FONTSTART);
+    
+    // level name from the image
+    s = P_String(M.name_string);
+    
+    while (*s)
+	HUlib_addCharToTextLine(&w_title, *(s++));
+#endif
+
+    headsupactive = true;
+
+}
+
+//
+// HU_Drawer
+// The message line is in the status band (port/render/r_band.c): it is
+// marked for the compositor when what it shows changed. The automap
+// title of the host build goes to the temporary screen.
+//
+void HU_Drawer(void)
+{
+    static unsigned	shown;
+    unsigned		sig = 0;
+    int			i;
+    char*		c;
+
+    if (*w_message.on)
+    {
+	sig = 2166136261u;
+	for (i = 0; i < w_message.h; i++)
+	    for (c = w_message.l[i].l; ; c++)
+	    {
+		sig = (sig ^ (unsigned char) *c) * 16777619u;
+		if (!*c)
+		    break;
+	    }
+	sig |= 1;
+    }
+    if (sig != shown)
+    {
+	shown = sig;
+	R_BandMarkHud();
+    }
+
+#ifndef DMC_FW
+    if (automapactive)
+	HUlib_drawTextLine(&w_title, false);
+#endif
+
+}
+
+// The message line for the band compositor.
+void HU_DrawBand(void)
+{
+    HUlib_drawSText(&w_message);
+}
+
+void HU_Erase(void)
+{
+
+    HUlib_eraseSText(&w_message);
+#ifndef DMC_FW
+    HUlib_eraseTextLine(&w_title);
+#endif
+
+}
+
+void HU_Ticker(void)
+{
+
+    // tick down message counter if message is up
+    if (message_counter && !--message_counter)
+    {
+	message_on = false;
+	message_nottobefuckedwith = false;
+    }
+
+    if (showMessages || message_dontfuckwithme)
+    {
+
+	// display message if necessary
+	if ((plr->message && !message_nottobefuckedwith)
+	    || (plr->message && message_dontfuckwithme))
+	{
+	    HUlib_addMessageToSText(&w_message, 0, plr->message);
+	    plr->message = 0;
+	    message_on = true;
+	    message_counter = HU_MSGTIMEOUT;
+	    message_nottobefuckedwith = message_dontfuckwithme;
+	    message_dontfuckwithme = 0;
+	}
+
+    } // else message_on = false;
+
+}
+
+boolean HU_Responder(event_t *ev)
+{
+
+    boolean		eatkey = false;
+
+    if (ev->type != ev_keydown)
+	return false;
+
+    if (ev->data1 == key_message_refresh)
+    {
+	message_on = true;
+	message_counter = HU_MSGTIMEOUT;
+	eatkey = true;
+    }
+
+    return eatkey;
+
+}
