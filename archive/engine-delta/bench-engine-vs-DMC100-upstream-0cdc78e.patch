+// DESCRIPTION:
+//	Gamma correction LUT stuff.
+//	Functions to draw patches (by post) directly to screen.
+//	Functions to blit a block to the screen.
+//
+
+#include <stdio.h>
+#include <string.h>
+#include <math.h>
+
+#include "i_system.h"
+
