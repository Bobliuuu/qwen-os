+// tmbbox around x, y
+static void P_SetBox (fixed_t x, fixed_t y, fixed_t r)
+{
+    tmbbox[BOXTOP] = y + r;
+    tmbbox[BOXBOTTOM] = y - r;
+    tmbbox[BOXRIGHT] = x + r;
+    tmbbox[BOXLEFT] = x - r;
+}
