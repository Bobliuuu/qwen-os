+		// maybe could warn here?
+		mode = "rgba8888";
+	}
+
+	if (strcmp(mode, "rgba8888") == 0) {
+		// default mode
+		s_Fb.bits_per_pixel = 32;
+
+		s_Fb.blue.length = 8;
+		s_Fb.green.length = 8;
