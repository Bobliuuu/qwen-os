+
+#include "fe.h"
+#include "things.h"
+
+
+int	leveltime;
+
+
+//
+// P_Ticker
+// The thinkers run in the object store (port/obj/things.c).
+//
+
+void P_Ticker (void)
+{
+    int		i;
+    
+    // run the tic
+    if (paused)
+	return;
+		
+    // pause if in menu and at least one tic has been run
+    if ( !netgame
+	 && menuactive
+	 && !demoplayback
+	 && players[consoleplayer].viewz != 1)
+    {
+	return;
+    }
+    
+    // the tic scratch holds the hashes of the front end's screen
+    fe.flags &= ~FE_HASHED;
+#ifdef DMC_STATS
+    // host: nothing in the tic scratch outlives a tic
+    memset (&dmc_tic, 0xa5, sizeof(dmc_tic));
+    HS_Event (HS_E_THINK, NULL);
+#endif
+
+    for (i=0 ; i<MAXPLAYERS ; i++)
+	if (playeringame[i])
+	    P_PlayerThink (&players[i]);
+			
+    O_RunThinkers ();
+    P_UpdateSpecials ();
+#ifdef DMC_STATS
+    HS_Event (HS_E_THINK_END, NULL);
+    O_Stats ();
+#endif
+
+    // for par times
+    leveltime++;	
+    o_cursor = -1;
+}
