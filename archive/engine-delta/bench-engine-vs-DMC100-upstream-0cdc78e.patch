+        put(s, "pl.damagecount", i, p->damagecount);
+        put(s, "pl.bonuscount", i, p->bonuscount);
+        put(s, "pl.attacker", i, ref(s, mobj_key(p->attacker)));
+        put(s, "pl.extralight", i, p->extralight);
+        put(s, "pl.fixedcolormap", i, p->fixedcolormap);
+        for (int k = 0; k < 2; k++) {
