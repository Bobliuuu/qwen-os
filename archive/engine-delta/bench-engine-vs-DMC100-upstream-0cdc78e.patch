+//
+// Function that changes wall texture.
+// Tell it if switch is ok to use again (1=yes, it's a button).
+//
+void
+P_ChangeSwitchTexture
+( lineidx_t	line,
+  int 		useAgain )
+{
+    int     texTop;
+    int     texMid;
+    int     texBot;
+    int     i;
+    int     k;
+    int     tex;
+    int     sound;
+    side_t  side;
+    sideidx_t sd;
+    void*   org;
+    dmc_anim_t a;
+	
+    if (!useAgain)
+	P_SetLineSpecial(line, 0);
+
+    sd = P_LineSide(line, 0);
+    P_GetSide(sd, &side);
+    texTop = side.toptexture;
+    texMid = side.midtexture;
+    texBot = side.bottomtexture;
+	
+    sound = sfx_swtchn;
+
+    // EXIT SWITCH?
+    if (P_LineSpecial(line) == 11)                
+	sound = sfx_swtchx;
+
+    // vanilla plays it at the sound origin of button 0
+    org = buttonlist[0].btimer ? P_SecSoundOrg(P_LineFrontSector(buttonlist[0].line)) : NULL;
+	
+    for (k = 0; k < anim_count(); k++)
+    {
+	anim_get(k, &a);
+	if (a.kind != DMC_ANIM_SWITCH)
+	    continue;
+	// texture numbers are global ids + 1
+	for (i = 0; i < 2; i++)
+	{
+	    tex = (i ? a.last : a.first) + 1;
+	    if (tex == texTop)
+	    {
+		S_StartSound(org,sound);
+		P_SetSideTexture(sd, 0, ((tex - 1) ^ 1) + 1);
+
+		if (useAgain)
+		    P_StartButton(line,top,tex,BUTTONTIME);
+
+		return;
+	    }
+	    else
+	    {
+		if (tex == texMid)
+		{
+		    S_StartSound(org,sound);
+		    P_SetSideTexture(sd, 1, ((tex - 1) ^ 1) + 1);
+
+		    if (useAgain)
+			P_StartButton(line, middle,tex,BUTTONTIME);
+
+		    return;
+		}
+		else
+		{
+		    if (tex == texBot)
+		    {
+			S_StartSound(org,sound);
+			P_SetSideTexture(sd, 2, ((tex - 1) ^ 1) + 1);
+
+			if (useAgain)
+			    P_StartButton(line, bottom,tex,BUTTONTIME);
+
+			return;
+		    }
+		}
+	    }
+	}
+    }
+}
