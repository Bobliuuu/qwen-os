+//
+// EVENTS
+// Events are operations triggered by using, crossing,
+// or shooting special lines, or by timed thinkers.
+//
+
+//
+// P_CrossSpecialLine - TRIGGER
+// Called every time a thing origin is about
+//  to cross a line with a non 0 special.
+//
+void
+P_CrossSpecialLine
+( int		linenum,
+  int		side,
+  mobj_t*	thing )
+{
+    lineidx_t	line;
+    int		ok;
+
+    line = linenum;
+#ifdef DMC_STATS
+    HS_Event (HS_E_CROSS, thing);
+#endif
+    
+    //	Triggers that other things can activate
+    if (!MO_PLAYER(thing))
+    {
+	// Things that should NOT trigger specials...
+	// (the BFG and the cacodemon's shot are not in E1)
+	switch(thing->type)
+	{
+	  case MT_ROCKET:
+#ifdef DMC_HAVE_MT_PLASMA
+	  case MT_PLASMA:
+#endif
+	  case MT_TROOPSHOT:
+	  case MT_BRUISERSHOT:
+	    return;
+	    break;
+	    
+	  default: break;
+	}
+		
+	ok = 0;
+	switch(P_LineSpecial(line))
+	{
+	  case 39:	// TELEPORT TRIGGER
+	  case 97:	// TELEPORT RETRIGGER
+	  case 125:	// TELEPORT MONSTERONLY TRIGGER
+	  case 126:	// TELEPORT MONSTERONLY RETRIGGER
+	  case 4:	// RAISE DOOR
+	  case 10:	// PLAT DOWN-WAIT-UP-STAY TRIGGER
+	  case 88:	// PLAT DOWN-WAIT-UP-STAY RETRIGGER
+	    ok = 1;
+	    break;
+	}
+	if (!ok)
+	    return;
+    }
+#ifdef DMC_STATS
+    HS_Event (HS_E_HANDLED, thing);
+#endif
+
+    // all movers of the activation or none: the special stays
+    if (!P_MoverReserve(line, P_LineSpecial(line)))
+	return;
+    
+    // Note: could use some const's here.
+    switch (P_LineSpecial(line))
+    {
+	// TRIGGERS.
+	// All from here to RETRIGGERS.
+      case 2:
+	// Open Door
+	EV_DoDoor(line,vld_open);
+	P_SetLineSpecial(line, 0);
+	break;
+
+      case 3:
+	// Close Door
+	EV_DoDoor(line,vld_close);
+	P_SetLineSpecial(line, 0);
+	break;
+
+      case 4:
+	// Raise Door
+	EV_DoDoor(line,vld_normal);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 5:
+	// Raise Floor
+	EV_DoFloor(line,raiseFloor);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 6:
+	// Fast Ceiling Crush & Raise
+	EV_DoCeiling(line,fastCrushAndRaise);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 8:
+	// Build Stairs
+	EV_BuildStairs(line,build8);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 10:
+	// PlatDownWaitUp
+	EV_DoPlat(line,downWaitUpStay,0);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 12:
+	// Light Turn On - brightest near
+	EV_LightTurnOn(line,0);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 13:
+	// Light Turn On 255
+	EV_LightTurnOn(line,255);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 16:
+	// Close Door 30
+	EV_DoDoor(line,vld_close30ThenOpen);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 17:
+	// Start Light Strobing
+	EV_StartLightStrobing(line);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 19:
+	// Lower Floor
+	EV_DoFloor(line,lowerFloor);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 22:
+	// Raise floor to nearest height and change texture
+	EV_DoPlat(line,raiseToNearestAndChange,0);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 25:
+	// Ceiling Crush and Raise
+	EV_DoCeiling(line,crushAndRaise);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 30:
+	// Raise floor to shortest texture height
+	//  on either side of lines.
+	EV_DoFloor(line,raiseToTexture);
+	P_SetLineSpecial(line, 0);
+	break;
+	
+      case 35:
