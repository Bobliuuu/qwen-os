+FW_PLAT_MENU := settings
+FW_PLAT_USB := usbd
+FW_OVL_OBJS = $(patsubst %.c,$(FW_O)/%.o,$(FW_SRC_$(2))) $(FW_PLAT_$(2):%=$(BUILD)/plat/$(FW_PDIR_$(1))/%.o)
