+        self.used = off
+        self.align = max([t.align if isinstance(t, Struct) else _SIZE[t] for _, t, _ in self.fields])
+        if off < size:
+            fmt += "%dx" % (size - off)
+        self.st = struct.Struct(fmt)
+        assert self.st.size == size, (cname, self.st.size, size)
