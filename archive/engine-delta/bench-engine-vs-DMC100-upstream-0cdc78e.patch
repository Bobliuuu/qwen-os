+def exit_words(spec):
+    """dmc_test.exits of an --exit-list (tests/lockstep/play.h): level times, bit 15 for a
+    secret exit."""
+    return [int(e.rstrip("s")) | (0x8000 if e.endswith("s") else 0) for e in spec.split(",")]
