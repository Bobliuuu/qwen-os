+//
+// Determines bounding box of all vertices,
+// sets global variables controlling zoom range.
+//
+void AM_findMinMaxBoundaries(void)
+{
+    int i;
+    fixed_t a;
+    fixed_t b;
+
+    min_x = min_y =  INT_MAX;
+    max_x = max_y = -INT_MAX;
+  
+    // the line ends stand for the vertexes, which the image does not keep
+    for (i=0;i<numlines;i++)
+    {
+	line_t	ln;
+	int	k;
+
+	P_GetLine(i, &ln);
+	for (k=0;k<2;k++)
+	{
+	    fixed_t vx = k ? ln.v2x : ln.v1x;
+	    fixed_t vy = k ? ln.v2y : ln.v1y;
+
+	    if (vx < min_x)
+		min_x = vx;
+	    else if (vx > max_x)
+		max_x = vx;
+    
+	    if (vy < min_y)
+		min_y = vy;
+	    else if (vy > max_y)
+		max_y = vy;
+	}
+    }
+  
+    max_w = max_x - min_x;
+    max_h = max_y - min_y;
+
+    min_w = 2*PLAYERRADIUS; // const? never changed?
+    min_h = 2*PLAYERRADIUS;
+
+    a = FixedDiv(f_w<<FRACBITS, max_w);
+    b = FixedDiv(f_h<<FRACBITS, max_h);
+  
+    min_scale_mtof = a < b ? a : b;
+    max_scale_mtof = FixedDiv(f_h<<FRACBITS, 2*PLAYERRADIUS);
+
+}
