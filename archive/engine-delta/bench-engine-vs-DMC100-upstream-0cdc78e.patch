+_Static_assert(offsetof(dmc_header_t, fmt_minor) == 10, "dmc_header_t.fmt_minor");
+_Static_assert(offsetof(dmc_header_t, image_size) == 12, "dmc_header_t.image_size");
+_Static_assert(offsetof(dmc_header_t, split) == 16, "dmc_header_t.split");
+_Static_assert(offsetof(dmc_header_t, image_uuid) == 20, "dmc_header_t.image_uuid");
