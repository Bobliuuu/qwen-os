+
+int P_Rejected (int s1, int s2)
+{
+    int		pnum = s1 * numsectors + s2;
+    int		bit = (map_reject(pnum >> 3) >> (pnum & 7)) & 1;
+
+#ifdef DMC_PARITY
+    PAR_Reject(s1, s2, bit);
+#endif
+    return bit;
+}
