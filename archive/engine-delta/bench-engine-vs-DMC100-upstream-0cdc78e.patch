+
+// We are referring to patches.
+#include "r_defs.h"
+
+//
+// Typedefs of widgets
+//
+// The widgets are constant: their places, values and pictures do not change
+// in a single player game, so they stay in flash. What a widget last drew is
+// the st_state_t it points to.
+
+typedef struct
+{
+    // last number, icon or value drawn
+    short	old;
+
+    // multicon: the last draw erased the previous icon first
+    // (status band compose)
+    short	erased;
+
+} st_state_t;
+
+
+// Number widget
+
+typedef struct
+{
+    // upper right-hand corner
+    //  of the number (right-justified)
+    short	x;
+    short	y;
+
+    // max # of digits in number
+    short width;    
+
+    // pointer to current value
+    int*	num;
+
+    // pointer to boolean stating
+    //  whether to update number
+    boolean*	on;
+
+    // list of patches for 0-9, as UI ids (DMC_UI_*)
+    const unsigned char*	p;
+
+    // last number value
+    st_state_t*	s;
+    
+} st_number_t;
+
+
+
+// Percent widget ("child" of number widget,
+//  or, more precisely, contains a number widget.)
+typedef struct
+{
+    // number information
+    st_number_t		n;
+
+    // percent sign graphic, a UI id
+    int		p;
+    
+} st_percent_t;
+
+
+
+// Multiple Icon widget
+typedef struct
+{
+     // center-justified location of icons
+    short		x;
+    short		y;
+
+    // pointer to current icon
+    int*		inum;
+
+    // pointer to boolean stating
+    //  whether to update icon
+    boolean*		on;
+
+    // list of icons, as UI ids
+    const unsigned char*	p;
+
+    // last icon number, and whether its draw erased
+    st_state_t*		s;
+
+} st_multicon_t;
+
+
+
+
+// Binary Icon widget
+
+typedef struct
+{
+    // center-justified location of icon
+    short		x;
+    short		y;
+
+    // pointer to current icon status
+    boolean*		val;
+
+    // pointer to boolean
+    //  stating whether to update icon
+    boolean*		on;  
+
+
+    int		p;	// icon, a UI id
+
+    // last icon value
+    st_state_t*		s;
+    
+} st_binicon_t;
+
