+// Modified 2026 for the DMC-100 port.
+//
+// DESCRIPTION:
+//     Main loop code.
+//
+
+#include <string.h>
+
+#include "doomdef.h"
+#include "doomstat.h"
+
+#include "d_event.h"
+#include "d_loop.h"
+#include "d_main.h"
+#include "d_ticcmd.h"
+#include "g_game.h"
+#include "m_menu.h"
