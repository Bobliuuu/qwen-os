+// Image header at logical offset 0. The header block is HEADER_SIZE bytes, CRC over all of it with header_crc = 0.
+typedef struct {
+    char magic[8];
+    uint16_t fmt_major;
+    uint16_t fmt_minor;
+    uint32_t image_size;
+    uint32_t split;
+    uint8_t image_uuid[16];
+    uint8_t wad_sha256[32];
+    char conv_version[16];
+    char pack_id[8];
+    uint16_t nsect;
+    uint16_t nmaps;
+    uint32_t flags;
+    uint32_t header_crc;
+    uint8_t skill_group[5];
+    uint8_t pad_[3];
+} dmc_header_t;
+_Static_assert(sizeof(dmc_header_t) == 112, "dmc_header_t size");
+_Static_assert(offsetof(dmc_header_t, magic) == 0, "dmc_header_t.magic");
