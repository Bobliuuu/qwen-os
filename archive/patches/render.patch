+
+// A record in one line that is not in the cache (outside the baked ranges): fill, then copy.
+__attribute__((noinline)) static void rec_get_miss(uint32_t loff, void *out, uint32_t n)
+{
+    const uint8_t *p = rc_fill(loff / RC_LINE) + (loff & (RC_LINE - 1));
+    if (!(((uintptr_t)p | (uintptr_t)out) & 3u)) {
+        const uint32_t *s = (const uint32_t *)(const void *)p;
+        uint32_t *d = (uint32_t *)out;
+        if (n == 16) {
+            uint32_t a = s[0], b = s[1], c = s[2], e = s[3];
+            d[0] = a; d[1] = b; d[2] = c; d[3] = e;
+            return;
+        }
+        if (n == 8) {
+            uint32_t a = s[0], b = s[1];
+            d[0] = a; d[1] = b;
+            return;
+        }
+        if (n == 4) {
+            d[0] = s[0];
+            return;
+        }
+    }
+    memcpy(out, p, n);
+}
+
+// Hit paths: leaf functions (no saved registers) for a record in one line of the cache and
+// outside the baked ranges; everything else takes the full versions above.
+void rec_get(uint32_t loff, void *out, uint32_t n)
+{
+    if (loff - bake_lo >= bake_span && n - 1u < RC_LINE - (loff & (RC_LINE - 1))) {
+        const uint8_t *p = rc_hit(loff);
+        if (p) {
+            if (!(((uintptr_t)p | (uintptr_t)out) & 3u)) {
+                const uint32_t *s = (const uint32_t *)(const void *)p;
+                uint32_t *d = (uint32_t *)out;
+                if (n == 16) {
+                    uint32_t a = s[0], b = s[1], c = s[2], e = s[3];
+                    d[0] = a; d[1] = b; d[2] = c; d[3] = e;
+                    return;
+                }
+                if (n == 8) {
+                    uint32_t a = s[0], b = s[1];
+                    d[0] = a; d[1] = b;
+                    return;
+                }
+                if (n == 4) {
+                    d[0] = s[0];
+                    return;
+                }
+            }
+            memcpy(out, p, n);
+            return;
+        }
+        rec_get_miss(loff, out, n);
+        return;
+    }
+    rec_get_full(loff, out, n);
+}
+
+uint16_t rec_u16(uint32_t loff)
+{
+    if (!(loff & 1u) && loff - bake_lo >= bake_span) {
+        const uint8_t *p = rc_hit(loff);
+        if (p)
+            return *(const uint16_t *)(const void *)p;
+    }
+    return rec_u16_full(loff);
+}
+
+uint32_t rec_u32(uint32_t loff)
+{
+    if (!(loff & 3u) && loff - bake_lo >= bake_span) {
+        const uint8_t *p = rc_hit(loff);
+        if (p)
+            return *(const uint32_t *)(const void *)p;
+    }
+    return rec_u32_full(loff);
 }
