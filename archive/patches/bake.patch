+for o,l,ra,t in rows:
+    lo=phys2log(o); U[cls(lo)].add((lo,l))
+print('--- unique requests / bytes per class (union), section sizes')
+sz={n:s for o,s,n in secs}
+tot=0
+for c,v in sorted(U.items(),key=lambda kv:-len(kv[1])):
+    if c.startswith('other'): continue
+    # union bytes
+    iv=sorted((a,a+b) for a,b in v); u=0; cur=-1
+    for a,b in iv:
+        a=max(a,cur); 
+        if b>a: u+=b-a; cur=b
+    print('%-14s uniq_req %6d union %8d  of %8d'%(c,len(v),u,sz.get(c,0)))
