+"""bake_eval.py NOR.img RANGES.txt TEST.req[,..]: share of the logged disk requests that a block list covers
+(REQLOG files of unbaked runs; hold-out check of tools/bake_select.py)."""
+import sys,struct,os
+U=int(os.environ.get('BAKE_UNIT',4))
+img=open(sys.argv[1],'rb').read()
+def vol(base,name):
+    bps,spc,res,nf,nroot,tot,_,fsz=struct.unpack_from('<HBHBHHBH',img,base+11)
+    root=base+(res+nf*fsz)*bps
+    for i in range(nroot):
+        e=img[root+i*32:root+i*32+32]
+        if e[:11]==name: return root+nroot*32,struct.unpack_from('<I',e,28)[0]
+    return None,0
+d0,split=vol(0x100000,b'DOOM    DAT'); d1,_=vol(0,b'DOOMX   DAT')
+def l_of(p): return p-d0 if d0<=p<d0+split else p-d1-64+split
+sel=set()
+for l in open(sys.argv[2]):
+    if l[0]=='#': continue
+    s,c=map(int,l.split()); sel.update(range(s,s+c))
+for p in sys.argv[3].split(','):
+    d=open(p,'rb').read(); n=len(d)//16; ok=0; okb=0; tb=0
+    for i in range(n):
+        o,l,ra,t=struct.unpack_from('<IIII',d,i*16); lo=l_of(o)
+        if lo<4096: ok+=1; continue
+        if all(u in sel for u in range(lo//U,(lo+l-1)//U+1)): ok+=1
+    print('%s: %.1f%% covered (%d residual of %d)'%(p.split('/')[-1],100*ok/n,n-ok,n))
