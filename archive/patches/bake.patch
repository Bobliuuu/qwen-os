diff -ruN pa/engine/engine/r_data.c pb/engine/engine/r_data.c
--- pa/engine/engine/r_data.c	2026-11-03 18:33:18
+++ pb/engine/engine/r_data.c	2026-11-03 19:19:53
@@ -305,11 +305,27 @@
 // on the bus at once (direct set and the bus free), else that of the
 // queued read. The direct read of the queued column ends first, so at
 // most one buffer holds ticket -1 and nor_col_wait ends exactly its read.
+#ifdef DMC_FW
+extern uint32_t bake_lo, bake_span;
+const uint8_t *bake_get (uint32_t loff, uint32_t *run);
+#endif
 static int R_ColRead (const r_colwin_t* w, uint32_t rel, byte* dst, unsigned n, int direct)
 {
     nor_col_wait ();
     if (cbuf[clast].ticket < 0)
 	cbuf[clast].ticket = 0;
+#ifdef DMC_FW
+    {
+	// data baked into the data ROM: copied, no request
+	uint32_t	run;
+	const byte*	b;
+	if (w->loff + rel - bake_lo < bake_span && (b = bake_get (w->loff + rel, &run)) && run >= n)
+	{
+	    memcpy (dst, b, n);
+	    return 0;
+	}
+    }
+#endif
     if (direct && rel + n <= w->run && !nor_col_start (w->phys + rel, dst, n))
     {
 #ifdef DMC_STATS
diff -ruN pa/engine/port/data/cache.c pb/engine/port/data/cache.c
--- pa/engine/port/data/cache.c	2026-11-03 19:02:16
+++ pb/engine/port/data/cache.c	2026-11-03 19:19:43
@@ -8,20 +8,18 @@
 #include "nor.h"
 
 #ifdef DMC_FW
-// Map streams baked into the data ROM (ports/doomdmc/qbake.c, bakemap.c): reads inside them never
-// touch the cache or the disk. bake_span is 0 unless the image's map entry matches the baked one.
-extern uint32_t bake_lo, bake_span, bake_n;
-extern const uint32_t bake_rng[][3], bake_data[];
+// Data baked into the data ROM (ports/doomdmc/qbake.c, bakemap.c): reads inside it never touch the
+// cache or the disk. bake_span is 0 unless the image's header CRC matches the baked image.
+extern uint32_t bake_lo, bake_span;
+const uint8_t *bake_get(uint32_t loff, uint32_t *run);
 static inline const uint8_t *bake_ptr(uint32_t loff, uint32_t n)
 {
+    uint32_t run;
+    const uint8_t *p;
     if (loff - bake_lo >= bake_span)
         return 0;
-    for (uint32_t i = 0; i < bake_n; i++) {
-        uint32_t rel = loff - bake_rng[i][0];
-        if (rel < bake_rng[i][1] && n <= bake_rng[i][1] - rel)
-            return (const uint8_t *)bake_data + bake_rng[i][2] + rel;
-    }
-    return 0;
+    p = bake_get(loff, &run);
+    return p && run >= n ? p : 0;
 }
 #else
 #define bake_span 0u
@@ -159,8 +157,11 @@
     if (!rc2_mem || !rc2_swap(ln, set, w, old))
 #endif
     {
+        const uint8_t *bp = bake_ptr(loff, n);
         const uint32_t *pw = img_pw[loff >= img.split];
-        if (loff - pw[0] < pw[1] - pw[0] && pw[1] - loff >= n)
+        if (bp)
+            memcpy(rc_data[base + w], bp, n);
+        else if (loff - pw[0] < pw[1] - pw[0] && pw[1] - loff >= n)
             nor_read(pw[2] + loff, rc_data[base + w], n);
         else
             img_read(loff, rc_data[base + w], n);
