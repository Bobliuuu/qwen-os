+#!/bin/bash
+# bake_route.sh ROUTE TAG: build the E1M1 mode-2 image for scripted route ROUTE (-DQ_ROUTE, see
+# doomd_main.c: 0 = the default script, 1-3 scripted walks, >=10 pseudo-random walks), run it on the E1 pack
+# and print tic / request statistics. TAG ending in "nb" builds without the bake (and writes the REQLOG a
+# training run needs); any other TAG builds with it (BAKE_RANGES=file to try another block list).
+# env: DMC (engine checkout), IMG (pack name, default E1), INSTR (instruction budget), XCF (extra cflags,
+# -DQ_DUMP_ALL to dump every frame for hash compares), OUTDIR (default /tmp).
+# After a bake_route.sh R nb run: tools/bake_select.py IMG BUDGET ports/doomdmc/bake_e1m1.txt $OUTDIR/rRnb.req,...
+R=$1; TAG=${2:-nb}; INSTR=${INSTR:-420000000}
+REPO=$(cd "$(dirname "$0")/.." && pwd); S=${OUTDIR:-/tmp}
+export DMC=${DMC:?set DMC to the DMC100-Doom checkout}
+cd $REPO
+OUT=build/doomdmc-r$R$TAG
+mkdir -p $OUT/o
+case $TAG in *nb) export NOBAKE=1;; esac
+FORCE=1 DOOMD_MODE=2 EXTRA_CF="-DQ_ROUTE=$R $XCF" ports/doomdmc/build.sh $OUT >/dev/null
+python3 tools/merge_elf.py $S/r$R$TAG.elf build/kernel-doomd.elf build/shell.elf build/paint.elf build/raycast.elf build/asset.elf build/doom.elf $OUT/doomd.elf >/dev/null
+cp $OUT/doomd.elf $S/r$R$TAG.sym.elf
+SYMELF=$S/r$R$TAG.sym.elf REQPROF=1 REQLOG=$S/r$R$TAG.req build/rv32_fast $S/r$R$TAG.elf $DMC/build/sw/nor/${IMG:-E1}.img 100 108 $S/r$R$TAG.bin $INSTR 2>&1 | grep -E "LEVEL|GAMETICS|DISK|steps|FAULT|^TICS"
diff -ruN pa/repo/tools/bake_select.py pb/repo/tools/bake_select.py
--- pa/repo/tools/bake_select.py	1969-12-31 19:00:00
+++ pb/repo/tools/bake_select.py	2026-11-03 19:44:51
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""bake_select.py NOR.img BUDGET_BYTES OUT.txt TRAIN.req[,TRAIN2.req...] [--first W] [--grow G]
+Chooses the 4-byte units of the logical image to bake from REQLOG files of unbaked runs
+(tools/rv32_fast REQLOG; records off,len,ra,tic with off = NOR address): units are ranked by
+the number of disk requests touching them (requests of the load + first frame, tic <= FIRST,
+count W times), the best fill the budget (the 4-byte run table entries are charged too).
+--grow G adds G units of neighbours on each side of every chosen run when budget remains."""
+import struct, sys, collections, os
+U = int(os.environ.get('BAKE_UNIT', 4))   # the ROM format is 4-byte units
+img = open(sys.argv[1], 'rb').read()
+budget = int(sys.argv[2]); out = sys.argv[3]; logs = sys.argv[4].split(',')
+W = int(sys.argv[sys.argv.index('--first') + 1]) if '--first' in sys.argv else 5
+def vol(base, name):
+    bps, spc, res, nf, nroot, tot, _, fsz = struct.unpack_from('<HBHBHHBH', img, base + 11)
+    root = base + (res + nf * fsz) * bps
+    for i in range(nroot):
+        e = img[root + i * 32:root + i * 32 + 32]
+        if e[:11] == name: return root + nroot * 32, struct.unpack_from('<I', e, 28)[0]
+    return None, 0
+d0, split = vol(0x100000, b'DOOM    DAT'); d1, _ = vol(0, b'DOOMX   DAT')
+def l_of(p): return p - d0 if d0 <= p < d0 + split else (p - d1 - 64 + split if d1 and p >= d1 + 64 else None)
+cnt = collections.Counter()
+for p in logs:
+    d = open(p, 'rb').read()
+    for i in range(len(d) // 16):
+        o, l, ra, t = struct.unpack_from('<IIII', d, i * 16)
+        lo = l_of(o)
+        if lo is None or lo < 4096: continue          # header / FAT / boot reads stay on the disk
+        w = W if t <= 1 else 5
+        for u in range(lo // U, (lo + l - 1) // U + 1): cnt[u] += w
+units = sorted(cnt, key=lambda u: (-cnt[u], u))
+n = 0; sel = []
+# run table cost: one u32 per run; estimate 4 B per selected unit's run start conservatively by
+# charging after merging, so iterate: take units until merged size + table exceeds the budget
+GAP = int(sys.argv[sys.argv.index('--gap') + 1]) if '--gap' in sys.argv else 5
+def fill(s):                              # bridge gaps of up to GAP units: cheaper than a run entry
+    s = sorted(set(s)); out = set(s)
+    for a, b in zip(s, s[1:]):
+        if 1 < b - a <= GAP + 1: out.update(range(a + 1, b))
+    return out
+def cost(s):
+    s = sorted(fill(s)); runs = 0; prev = -2
+    for u in s:
+        if u != prev + 1: runs += 1
+        prev = u
+    return len(s) * U + runs * 6 + 2 * (((max(s) - min(s)) * U >> 12) + 2)
+lo_n, hi_n = 0, len(units)
+while lo_n < hi_n:                       # largest prefix that fits
+    mid = (lo_n + hi_n + 1) // 2
+    if cost(units[:mid]) <= budget: lo_n = mid
+    else: hi_n = mid - 1
+sel = fill(units[:lo_n])
+rest = budget - cost(sel)
+if '--grow' in sys.argv:
+    G = int(sys.argv[sys.argv.index('--grow') + 1])
+    cand = []
+    for u in sorted(sel):
+        for k in range(1, G + 1):
+            for v in (u - k, u + k):
+                if v not in sel and v * U >= 4096: cand.append((k, -cnt.get(u, 0), v))
+    for k, _, v in sorted(cand):
+        if v in sel: continue
+        if rest < 20: break
+        sel.add(v); rest -= U
+sel = sorted(sel); runs = []
+for u in sel:
+    if runs and runs[-1][0] + runs[-1][1] == u: runs[-1][1] += 1
+    else: runs.append([u, 1])
+with open(out, 'w') as f:
+    f.write('# unit(4B) count; %d units, %d runs, from %s\n' % (len(sel), len(runs), ','.join(os.path.basename(x) for x in logs)))
+    for s, c in runs: f.write('%d %d\n' % (s, c))
+print('selected', len(sel), 'units =', len(sel) * U, 'B in', len(runs), 'runs; cost', cost(sel))
