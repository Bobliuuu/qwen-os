+void
+A_FireBFG
+( player_t*	player,
+  pspdef_t*	psp )
+{
+    DecreaseAmmo(player, weaponinfo[player->readyweapon].ammo, deh_bfg_cells_per_shot);
+    P_SpawnPlayerMissile (player->mo, MT_BFG);
+}
+
+// A_BFGSpray: a BFG explosion on every monster in view of the ball's originator
+void A_BFGSpray (mobj_t* mo)
+{
+    int		i, j, damage;
+    angle_t	an;
+    mobj_t	view;
+    mobj_t	*src;
+
+    for (i=0 ; i<40 ; i++)
+    {
+	src = P_Target(mo);
+	an = mo->angle - ANG90/2 + ANG90/40*i;
+	P_AimLineAttack (src, an, 16*64*FRACUNIT);
+	if (!linetarget)
+	    continue;
+	{
+	    mobj_t *t = O_Get(linetarget, &view);
+	    P_SpawnMobj (t->x, t->y, t->z + (P_Height(t)>>2), MT_EXTRABFG);
+	}
+	damage = 0;
+	for (j=0;j<15;j++)
+	    damage += (P_Random()&7) + 1;
+	src = P_Target(mo);
+	P_DamageMobj (O_Get(linetarget, &view), src, src, damage);
+    }
+}
+
+void
+A_BFGsound
+( player_t*	player,
+  pspdef_t*	psp )
+{
+    S_StartSound (player->mo, sfx_bfg);
+}
 
 
